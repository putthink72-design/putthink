    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putthink needs the camera to scan the putting green between your ball and the hole, mark those two points, and build a LiDAR height map for aim and speed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボールとホールの間のグリーンをスキャンし、2点を指定し、LiDARでパッティング用の高さマップを作るためにカメラが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼과 홀 사이 그린을 스캔하고 두 지점을 지정하며, LiDAR로 퍼팅 높이맵을 만들기 위해 카메라가 필요합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Putthink needs photo library access so you can pick a Control Center screen recording to upload to Showcase."
          }
        }
      }
    }
  },
  "version" : "1.0"
