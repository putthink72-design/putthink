        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to scan the green between ball and hole and unlock putting aim and speed guidance. Auto-renews until you cancel. Payment is charged to your Apple ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購読するとボールとホールの間のグリーンをスキャンし、照準とスピード案内を利用できます。解約するまで自動更新され、Apple IDに請求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독하면 볼과 홀 사이 그린을 스캔하고 조준·스피드 가이드를 사용할 수 있습니다. 해지 전까지 자동 갱신되며 Apple ID로 결제됩니다."
          }
        }
      }
    },
