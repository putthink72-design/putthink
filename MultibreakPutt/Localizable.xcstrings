    "scan.step1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center the ball in the crosshair and we’ll find it automatically. You can also place it yourself on the turf under the crosshair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロスヘアの中央にボールを合わせると自動で検出します。ボールがなくても、クロスヘア下の芝を直接指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "십자선 중심에 볼을 맞추면 자동으로 볼을 찾습니다. 볼 없이도 십자선 지면을 직접 지정할 수 있습니다."
          }
        }
      }
    },
