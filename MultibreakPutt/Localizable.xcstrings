    "scan.step3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line up the cup-sized ring at screen center with the hole, then mark it. Your putting path is calculated right away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面中央のカップサイズの円をホール中心に合わせて指定してください。指定直後にパッティングラインが計算されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 중앙의 홀컵 사이즈 원을 홀의 중심에 맞춘 뒤 지정하세요. 지정 직후 퍼팅경로가 계산됩니다."
          }
        }
      }
    },
    "scan.step3.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Hole · Calculate Path"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホール指定 · ライン計算"
          }
        },
        "ko": {
