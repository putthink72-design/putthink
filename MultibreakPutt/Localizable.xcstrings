    "scan.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan Toward the Hole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホールまで斜めスキャン"
          }
        },
        "ko": {
