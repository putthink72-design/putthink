    "settings.subscribe.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe to scan the green between ball and hole and unlock putting aim and speed guidance. Auto-renews until you cancel. Payment is charged to your Apple ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読するとボールとホールの間のグリーンをスキャンし、照準とスピード案内を利用できます。解約するまで自動更新され、Apple IDに請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하면 볼과 홀 사이 그린을 스캔하고 조준·스피드 가이드를 사용할 수 있습니다. 해지 전까지 자동 갱신되며 Apple ID로 결제됩니다."
          }
        }
      }
    },
    "settings.subscribe.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscribe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독하기"
          }
        }
      }
    },
    "settings.subscribe.legal_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions auto-renew unless canceled at least 24 hours before the period ends. Price is charged to your Apple ID. Privacy Policy and Terms of Use are in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間終了の少なくとも24時間前に解約しない限り自動更新され、Apple IDに請求されます。プライバシーポリシーと利用規約は設定にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간이 끝나기 최소 24시간 전에 해지하지 않으면 구독은 자동 갱신되며 Apple ID로 청구됩니다. 개인정보 처리방침과 이용약관은 설정에 있습니다."
          }
        }
      }
    },
    "settings.subscribe.trial_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3-day free trial, then the plan price. Cancel at least 24 hours before the trial ends to avoid being charged. One trial per Apple ID for this subscription group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間の無料トライアル後にプラン料金が請求されます。請求を避けるにはトライアル終了の少なくとも24時間前に解約してください。このグループのトライアルはApple IDあたり1回です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 무료 체험 후 플랜 요금이 청구됩니다. 체험이 끝나기 최소 24시간 전에 해지하면 청구되지 않습니다. 이 구독 그룹은 Apple ID당 체험 1회입니다."
          }
        }
      }
    },
    "settings.subscribe.trial_cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start 3-day free trial"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間無料トライアルを開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 무료 체험 시작"
          }
        }
      }
    },
    "settings.subscribe.trial_short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any plan includes a 3-day free trial for first-time subscribers, then that plan’s price. Cancel at least 24 hours before the trial ends. One trial per Apple ID for this subscription group."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1·3·6개월·1년 모두 첫 구독에 3일 무료 체험이 있으며, 이후 선택한 플랜 요금이 청구됩니다. 체험 종료 최소 24시간 전에 해지하면 청구되지 않습니다. 이 구독 그룹은 Apple ID당 체험 1회입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1・3・6か月・1年のいずれも初回は3日間無料トライアルのあと、選んだプラン料金になります。終了の少なくとも24時間前に解約すれば請求されません。このグループのトライアルはApple IDあたり1回です。"
          }
        }
      }
    },
