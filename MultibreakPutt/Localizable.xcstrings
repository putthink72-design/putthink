    "scan.step2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the green around 40° (30°–40° recommended) and walk so the white mesh fills in. If you’re close to the hole, you can mark it now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グリーンを約40°（推奨30°–40°）で映しながら歩き、白いメッシュが埋まるようにスキャンしてください。ホールが近ければすぐ指定しても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그린을 약 40°(추천 30°–40°) 내외로 비추며 흰색매시가 생성되도록 걸으세요. 홀이 가까우면 바로 홀을 지정해도 됩니다."
          }
        }
      }
    },
    "scan.step2.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrived · Mark Hole"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホール到着 · ホール指定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홀 도착 · 홀 지정"
          }
        }
      }
    },
