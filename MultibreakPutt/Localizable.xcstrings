    "aim.no_path.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh scan can give a clearer surface. We won’t show a guessed straight line."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再スキャンすると、より正確な地形で案内できます。推測の直線は表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔을 다시 하면 더 정확한 지형으로 안내할 수 있습니다. 추정 직선은 표시하지 않습니다."
          }
        }
      }
    },
